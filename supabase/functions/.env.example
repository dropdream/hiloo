# Variables de la Edge Function emisor-agentes. En local van en supabase/functions/.env (ignorado);
# en el remoto, en los secretos de la función. Se generan con: node scripts/prueba-0b/claves.mjs
# EMISOR_ISSUER: URL pública de la función (iss de los tokens).
# EMISOR_CLAVE_JWK: clave privada ES256 en formato JWK, con kid. Nunca va al repo.
EMISOR_ISSUER=
EMISOR_CLAVE_JWK=
