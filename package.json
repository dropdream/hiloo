{
  "name": "hiloo",
  "version": "0.1.0",
  "private": true,
  "description": "Editor visual local de Markdown para Windows.",
  "author": "hiloo",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev --ignoreConfigWarning",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build --ignoreConfigWarning",
    "start": "electron-vite preview --ignoreConfigWarning",
    "brain": "node scripts/brain.cjs",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pretest": "install-electron",
    "test": "playwright test",
    "test:packaged": "playwright test --project=packaged"
  },
  "dependencies": {
    "@milkdown/kit": "7.22.2",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-toolbar": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "cytoscape": "3.34.3",
    "mermaid": "12.1.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
